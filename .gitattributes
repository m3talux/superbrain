# Force LF for all tracked text files so `git diff --exit-code dist` on the
# Windows CI runner doesn't flag CRLF-vs-LF differences against committed
# dist files (Windows defaults to CRLF on checkout otherwise).
* text=auto eol=lf

# Binary file types — git never normalizes these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
